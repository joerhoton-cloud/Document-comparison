# ---- Required ----
# Public URL of the app (no trailing slash). Used for sign-in links, OAuth callbacks and CSRF checks.
# On Render this is detected automatically; leave it unset there.
BASE_URL=https://compare.example.com
# Postgres connection string (docker-compose sets this for you).
DATABASE_URL=postgres://doccompare:password@localhost:5432/doccompare
# Long random secret for signing sessions: `openssl rand -base64 48`
BETTER_AUTH_SECRET=
# Used by docker-compose for the bundled Postgres.
POSTGRES_PASSWORD=

# ---- Email (required in production: set ONE of these) ----
# Sign-in links, email confirmation, password resets and invitations.
# Option A, quickest for testing: Gmail with an app password
#   (myaccount.google.com/apppasswords; needs 2-Step Verification). Spaces are fine.
SMTP_USER=you@gmail.com
SMTP_PASS=
# For another SMTP server also set SMTP_HOST (default smtp.gmail.com) and SMTP_PORT (default 465).
# (SMTP_URL=smtps://user%40domain:password@host:465 is also accepted.)
# Option B, for production: Resend (resend.com) with your own verified domain.
RESEND_API_KEY=
EMAIL_FROM=DocCompare <no-reply@yourdomain.com>

# ---- Billing (Stripe) ----
# Develop against a Stripe *sandbox* (Dashboard > Sandboxes), never your live account.
# In production keep these in your host's secrets store, not in a committed file.
#
# Use a RESTRICTED key (rk_...) rather than the full secret key (sk_...). Permissions needed:
#   Customers: Write · Checkout Sessions: Write · Subscriptions: Write
#   Customer portal: Write · Prices: Read · Products: Read · Invoices: Read
# Then run `stripe logs tail` while testing and add any permission that returns 403.
STRIPE_SECRET_KEY=
# Webhook endpoint: {BASE_URL}/api/auth/stripe/webhook, subscribed to:
#   checkout.session.completed
#   customer.subscription.created, customer.subscription.updated, customer.subscription.deleted
#   invoice.paid, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=
# Two plans, each its own Product with a flat monthly Price (`npm run stripe:setup` creates them):
#   Team: $49/month, up to 5 members · Unlimited: $100/month, unlimited members
STRIPE_PRICE_TEAM=
STRIPE_PRICE_UNLIMITED=
TRIAL_DAYS=14
# Stripe Tax: set to true ONLY after adding a tax registration (Dashboard > Tax > Registrations).
# Without a registration Stripe calculates and collects no tax, and reports no error.
STRIPE_AUTOMATIC_TAX=false
# To run without billing (e.g. a private internal deployment), set instead:
# BILLING_DISABLED=true

# ---- "Sign in with Microsoft / Google" (optional) ----
# Microsoft Entra ID app registration; redirect URI: {BASE_URL}/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" allows any work or personal Microsoft account; set a tenant ID to restrict to one company.
MICROSOFT_TENANT_ID=common
# Google OAuth client; redirect URI: {BASE_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Networking ----
# Header your load balancer uses for the client IP (for rate limiting).
CLIENT_IP_HEADER=x-forwarded-for
