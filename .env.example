# ---- Required ----
# Public URL of the app (no trailing slash). Used for sign-in links, OAuth callbacks and CSRF checks.
BASE_URL=https://compare.example.com
# Postgres connection string (docker-compose sets this for you).
DATABASE_URL=postgres://doccompare:password@localhost:5432/doccompare
# Long random secret for signing sessions: `openssl rand -base64 48`
BETTER_AUTH_SECRET=
# Used by docker-compose for the bundled Postgres.
POSTGRES_PASSWORD=

# ---- Email (required in production) ----
# Sign-in links, email confirmation, password resets and invitations are sent via Resend (resend.com).
RESEND_API_KEY=
EMAIL_FROM=DocCompare <no-reply@yourdomain.com>

# ---- Billing (Stripe) ----
# Create a product with a per-seat recurring price (monthly, and optionally yearly).
# Webhook endpoint: {BASE_URL}/api/auth/stripe/webhook with events:
#   checkout.session.completed, customer.subscription.created,
#   customer.subscription.updated, customer.subscription.deleted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
TRIAL_DAYS=14
# To run without billing (e.g. a private internal deployment), set instead:
# BILLING_DISABLED=true

# ---- "Sign in with Microsoft / Google" (optional) ----
# Microsoft Entra ID app registration; redirect URI: {BASE_URL}/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" allows any work or personal Microsoft account; set a tenant ID to restrict to one company.
MICROSOFT_TENANT_ID=common
# Google OAuth client; redirect URI: {BASE_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Networking ----
# Header your load balancer uses for the client IP (for rate limiting).
CLIENT_IP_HEADER=x-forwarded-for
