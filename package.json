{
  "name": "doccompare",
  "version": "0.1.0",
  "description": "Secure, client-side side-by-side document comparison (PDF, Word, HTML, text).",
  "scripts": {
    "predev": "node scripts/copy-pdf-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdf-assets.mjs",
    "build": "tsc -p . && tsc -p server && vite build && npm run build:server",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p . && tsc -p server",
    "build:single": "tsc -p . && vite build -c vite.artifact.config.ts && node scripts/inline-single.mjs",
    "dev:server": "tsx watch server/index.ts",
    "start": "node dist-server/index.mjs",
    "migrate": "tsx server/migrate-cli.ts",
    "test:server": "vitest run -c vitest.server.config.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist-server/index.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "stripe:setup": "node scripts/stripe-setup.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joerhoton-cloud/Document-comparison.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/joerhoton-cloud/Document-comparison/issues"
  },
  "homepage": "https://github.com/joerhoton-cloud/Document-comparison#readme",
  "dependencies": {
    "@better-auth/stripe": "^1.7.6",
    "@hono/node-server": "^2.1.3",
    "better-auth": "^1.7.6",
    "diff": "^9.0.0",
    "hono": "^4.13.12",
    "kysely": "^0.29.6",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.0.13",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.1",
    "qrcode-generator": "^2.0.4",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module",
  "overrides": {
    "@better-auth/core": "1.7.6"
  }
}
